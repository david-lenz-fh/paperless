# Standard: Automatische Normalisierung auf LF im Repository
* text=auto eol=lf

# Shell-Skripte und Docker-relevante Dateien MÜSSEN immer LF behalten
*.sh text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf

# Windows-spezifische Skripte (optional)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf